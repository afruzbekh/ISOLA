// Width/height come from Astro's image import metadata, so the
// orientation is known at build time (no waiting for the browser).
const toGalleryImage = ({
  img,
  brand,
}: {
  img: ImageMetadata;
  brand: string;
}) => ({
  src: img.src,
  width: img.width,
  height: img.height,
  alt: altFor(brand),
  orientation:
    img.width > img.height
      ? 'is-landscape'
      : img.height > img.width
        ? 'is-portrait'
        : 'is-square',
});

// PROJECT DATA
const projects = [
  {
    name: 'Офисы',
    category: 'Офисы',
    location: 'ТАШКЕНТ, УЗБЕКИСТАН',

    description: [
      'Комплексное оснащение офисов мебелью премиум-класса: авторские столы, переговорные группы, стеновые панели и функциональные системы хранения.',
      'Каждое решение разрабатывается под задачи бизнеса, объединяя выразительную эстетику, порядок на рабочем месте и надёжность на долгие годы.',
    ],

    images: receptionImages.map(toGalleryImage),
  },

  // Add more projects here
