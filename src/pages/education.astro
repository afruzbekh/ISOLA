---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Образование — реализованные проекты | ISOLA</title>

    <meta
      name="description"
      content="Проектирование и производство мебели для учебных центров и университетов от ISOLA. Современные, эргономичные и долговечные интерьерные решения для образовательных пространств в Ташкенте."
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="isola.uz" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="canonical" href="https://isola.uz/education/" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ISOLA",
        "url": "https://isola.uz",
        "logo": "https://isola.uz/logo.svg",
        "foundingDate": "2008",
        "sameAs": ["https://instagram.com/isola", "https://telegram.me/isola"],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "url": "https://isola.uz/education/"
        }
      }
    </script>

    <!-- LENIS SMOOTH SCROLL STYLES -->
    <style is:global>
      html.lenis,
      html.lenis body {
        height: auto;
      }

      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }

      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }

      .lenis.lenis-stopped {
        overflow: hidden;
      }

      .lenis.lenis-scrolling iframe {
        pointer-events: none;
      }
    </style>
  </head>

  <body>
    <NavBar />

    <main>
      <section class="showroom-page">
        <!-- INTRO -->
        <div class="showroom-intro">
          <div class="showroom-intro__top">
            <span class="eyebrow">
              <span class="eyebrow__line"></span>
              ISOLA - НАШИ ПРОЕКТЫ - Образование
            </span>

            <span class="intro-index" data-count={projects.length}>
              01
            </span>
          </div>

          <div class="showroom-intro__content">
            <h1>
              Среда, созданная
              <br />
              <span>для развития.</span>
            </h1>

            <p>
              Мы проектируем и изготавливаем мебель для университетов и учебных
              центров: надёжность, рассчитанная на интенсивную нагрузку, и
              современная эстетика, формирующая продуктивную атмосферу для
              обучения.
            </p>
          </div>
        </div>

        <!-- PROJECTS -->
        <div class="showroom-projects">
          {projects.map((project, projectIndex) => (
            <article class="project">
              <!-- PROJECT HEADING -->
              <div class="project__heading">
                <div class="project__title">
                  <span class="project__number">
                    {String(projectIndex + 1).padStart(2, '0')} —{' '}
                    {project.category}
                  </span>

                  <h2>{project.name}</h2>
                </div>

                <span class="project__location">{project.location}</span>
              </div>

              <!-- IMAGE GALLERY (orientation class + size rendered at build time) -->
              <div class="project-gallery">
                {project.images.map((image, imageIndex) => (
                  <div class={`project-gallery__item ${image.orientation}`}>
                    <img
                      src={image.src}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading={
                        projectIndex === 0 && imageIndex === 0
                          ? 'eager'
                          : 'lazy'
                      }
                      decoding="async"
                    />

                    <span class="image-index">
                      {String(imageIndex + 1).padStart(2, '0')} /
                      {String(project.images.length).padStart(2, '0')}
                    </span>
                  </div>
                ))}
              </div>

              <!-- SHOW MORE (hidden until the script finds hidden rows) -->
              <div class="gallery-more" hidden>
                <button type="button" class="gallery-more__btn">
                  <span class="gallery-more__progress"></span>
                  <span class="gallery-more__label">Показать ещё</span>
                  <span class="gallery-more__count">
                    <b data-shown>00</b> / <span data-total>00</span>
                  </span>
                  <svg
                    class="gallery-more__arrow"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M12 3v18M5 14l7 7 7-7" />
                  </svg>
                </button>
              </div>

              <!-- PROJECT DESCRIPTION -->
              <div class="project-info">
                <div class="project-info__description">
                  <span class="eyebrow">О ПРОЕКТЕ</span>

                  <h3>
                    Пространство, в котором дизайн встречается с
                    функциональностью.
                  </h3>
                </div>

                <div class="project-info__text">
                  {project.description.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- CLOSING STATEMENT -->
        <div class="showroom-closing">
          <span class="eyebrow">ISOLA — МЕБЕЛЬ И ПРОСТРАНСТВО</span>

          <h2>
            Внимание к деталям.
            <br />
            <span>Совершенство в исполнении.</span>
          </h2>
        </div>
      </section>
    </main>

    <Footer />

    <!-- LENIS SMOOTH SCROLL -->
    <script>
      import Lenis from 'lenis';

      function initLenis() {
        const lenis = new Lenis({
          lerp: 0.2,
          duration: 2.2,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            e.preventDefault();
            const target = anchor.getAttribute('href');
            if (target) lenis.scrollTo(target);
          });
        });
      }

      initLenis();

      document.addEventListener('astro:after-swap', initLenis);
    </script>

    <!-- The old IMAGE ORIENTATION DETECTION script is removed:
         orientation classes are now rendered on the server. -->

    <!-- GALLERY: SHOW 3 ROWS FIRST, THEN 3 MORE PER CLICK -->
    <script>
      const INITIAL_ROWS = 3; // rows visible before pressing "Показать ещё"
      const ROWS_PER_STEP = 3; // rows added on every click

      function initGalleryLimit() {
        document
          .querySelectorAll<HTMLElement>('.project')
          .forEach((project) => {
            const gallery =
              project.querySelector<HTMLElement>('.project-gallery');
            const more = project.querySelector<HTMLElement>('.gallery-more');
            const btn =
              more?.querySelector<HTMLButtonElement>('.gallery-more__btn');

            if (!gallery || !more || !btn || more.dataset.ready) return;
            more.dataset.ready = 'true';

            const items = [
              ...gallery.querySelectorAll<HTMLElement>(
                '.project-gallery__item'
              ),
            ];
            const shownEl = more.querySelector<HTMLElement>('[data-shown]');
            const totalEl = more.querySelector<HTMLElement>('[data-total]');
            const pad = (n: number) => String(n).padStart(2, '0');

            let visibleRows = INITIAL_ROWS;
            let rowStarts: number[] = [];

            // Index of the first item of every visual row
            function measureRows() {
              items.forEach((i) => i.classList.remove('is-collapsed'));
              rowStarts = [];
              let lastTop = -Infinity;

              items.forEach((item, idx) => {
                const top = item.offsetTop;
                if (top - lastTop > 8) {
                  rowStarts.push(idx);
                  lastTop = top;
                }
              });
            }

            function currentLimit() {
              return visibleRows < rowStarts.length
                ? rowStarts[visibleRows]
                : items.length;
            }

            function apply(animateFrom = -1) {
              const limit = currentLimit();

              items.forEach((item, i) => {
                item.classList.toggle('is-collapsed', i >= limit);
                item.classList.remove('is-revealing');

                if (animateFrom >= 0 && i >= animateFrom && i < limit) {
                  item.style.setProperty('--i', String(i - animateFrom));
                  void item.offsetWidth; // restart animation
                  item.classList.add('is-revealing');
                }
              });

              if (shownEl && shownEl.textContent !== pad(limit)) {
                shownEl.textContent = pad(limit);
                shownEl.classList.remove('is-tick');
                void shownEl.offsetWidth;
                shownEl.classList.add('is-tick');
              }

              if (totalEl) totalEl.textContent = pad(items.length);

              // 0 → 1, used by the progress line in CSS
              more!.style.setProperty(
                '--progress',
                String(limit / items.length)
              );

              more!.hidden = limit >= items.length;
            }

            btn.addEventListener('click', () => {
              const from = currentLimit();
              visibleRows += ROWS_PER_STEP;
              apply(from);
            });

            const refresh = () => {
              measureRows();
              apply();
            };

            refresh();
            window.addEventListener('load', refresh);
            // Re-measure once web fonts are ready (they can shift layout)
            document.fonts?.ready.then(refresh);

            let t: number;
            window.addEventListener('resize', () => {
              clearTimeout(t);
              t = window.setTimeout(refresh, 200);
            });
          });
      }

      initGalleryLimit();
      document.addEventListener('astro:after-swap', initGalleryLimit);
    </script>

    <!-- INTRO COUNTER ANIMATION -->
    <script>
      // Odometer-style counter: each digit is a vertical reel that rolls
      // up to its final number.
      function animateIntroCounter() {
        const counter = document.querySelector<HTMLElement>(
          '.intro-index[data-count]'
        );
        if (!counter || counter.dataset.ready) return;

        const el: HTMLElement = counter;
        const target = Math.max(Number(el.dataset.count) || 1, 1);
        const finalText = String(target).padStart(2, '0');

        el.dataset.ready = 'true';
        el.setAttribute('aria-label', finalText);

        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        if (reduceMotion) {
          el.textContent = finalText;
          return;
        }

        // ---- Settings you can tweak ----
        const startDelay = 600; // ms before the roll begins
        const lastDigitDuration = 3200; // ms, the rightmost digit
        const otherDigitDuration = 2400; // ms, the other digits
        const stagger = 150; // ms delay between digits
        // --------------------------------

        el.textContent = '';

        const reels: { reel: HTMLElement; finalIndex: number }[] = [];

        [...finalText].forEach((char, i) => {
          const digit = Number(char);
          const isLast = i === finalText.length - 1;

          // The last digit makes one extra full spin so the motion is
          // clearly visible, even when the total is small.
          const spins = isLast ? 1 : 0;

          const wrap = document.createElement('span');
          wrap.className = 'intro-digit';
          wrap.setAttribute('aria-hidden', 'true');

          const reel = document.createElement('span');
          reel.className = 'intro-digit__reel';
          reel.style.transitionDuration = `${
            isLast ? lastDigitDuration : otherDigitDuration
          }ms`;
          reel.style.transitionDelay = `${i * stagger}ms`;

          for (let n = 0; n < 10 * (spins + 1); n++) {
            const cell = document.createElement('span');
            cell.textContent = String(n % 10);
            reel.appendChild(cell);
          }

          wrap.appendChild(reel);
          el.appendChild(wrap);

          reels.push({ reel, finalIndex: 10 * spins + digit });
        });

        // Make sure the starting position is painted before rolling.
        void el.offsetWidth;

        window.setTimeout(() => {
          requestAnimationFrame(() => {
            reels.forEach(({ reel, finalIndex }) => {
              reel.style.transform = `translateY(calc(${-finalIndex} * 1.25em))`;
            });
          });
        }, startDelay);
      }

      animateIntroCounter();
      document.addEventListener('astro:after-swap', animateIntroCounter);
    </script>
  </body>
</html>
