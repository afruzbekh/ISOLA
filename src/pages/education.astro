// Width/height come from Astro's image import metadata, so the
// orientation is known at build time (no waiting for the browser).
// "Show more" measures rows by layout, so the layout must already be
// final when the script runs.
const toGalleryImage = ({ img, alt }: { img: ImageMetadata; alt: string }) => ({
  src: img.src,
  width: img.width,
  height: img.height,
  alt,
  orientation:
    img.width > img.height
      ? 'is-landscape'
      : img.height > img.width
        ? 'is-portrait'
        : 'is-square',
});

