---
import carshowroom from '../assets/images/carShowroom1.png';
import horeca from '../assets/images/hotels/Khiva_Hotel/2.jpg';
import office from '../assets/images/office.jpg';
import education from '../assets/images/education.jpg';
import interior from '../assets/images/kitchen.jpg';
import reception from '../assets/images/reception2.jpg';

const collections = [
  {
    index: '01',
    title: 'Автосалоны',
    desc: 'Архитектура премиального сервиса: от первого взгляда до передачи ключей.',
    img: carshowroom.src,
    alt: 'Мебель на заказ для автосалона премиум-класса: металлическая кофе-стойка, белый стеллаж и круглые столики с серыми стульями.',
    link: '/car-showrooms/',
  },
  {
    index: '02',
    title: 'HoReCa',
    desc: 'Эстетика притяжения: мебель, которая формирует характер вашего заведения.',
    img: horeca.src,
    alt: 'Мебель для ресторанов, кафе и отелей на заказ в Ташкенте: барная стойка, красные стулья и полукруглые зеленые велюровые диваны.',
    link: '/HoReCa/',
  },
  {
    index: '03',
    title: 'Офисы',
    desc: 'Форма власти и ясности: интерьер, который говорит о масштабе бизнеса без лишних слов.',
    img: office.src,
    alt: 'Изготовление офисной мебели на заказ в Ташкенте: угловой стол директора в цвете дуб и графит со встроенным стеллажом до потолка.',
    link: '/offices/',
  },
  {
    index: '04',
    title: 'Образование',
    desc: 'Надежность, рассчитанная на тысячи студентов, и эстетика, вдохновляющая на развитие.',
    img: education.src,
    alt: 'Мебель для учебного центра на заказ в Ташкенте: современные учебные столы, зона ресепшн и встроенные стеллажи для аудиторий.',
    link: '/education/',
  },
  {
    index: '05',
    title: 'Интерьеры',
    desc: 'Архитектура домашнего уюта: кухни, гардеробные и системы хранения, созданные под ваш ритм жизни.',
    img: interior.src,
    alt: 'Дизайнерский кухонный гарнитур на заказ в Ташкенте с островом, каменной столешницей и высокими шкафами под потолок.',
    link: '/interiors/',
  },
  {
    index: '06',
    title: 'Ресепшены',
    desc: 'Безупречные радиусы, благородные фактуры и ювелирная точность исполнения.',
    img: reception.src,
    alt: 'Эксклюзивная стойка администратора сложной формы для автоцентра BYD в Ташкенте — премиальная мебель на заказ.',
    link: '/receptions/',
  },
];
---

<section id="collections" class="OurCollectionsMain">
  <div class="OurCollectionsMain-bg">
    <img
      id="bg-image-current"
      src={collections[0].img}
      alt={collections[0].alt}
      fetchpriority="high"
    />
    <img
      id="bg-image-next"
      src={collections[0].img}
      alt={collections[0].alt}
      loading="lazy"
      style="opacity: 0;"
    />
  </div>

  <div class="OurCollectionsMain-container">
    <!-- LEFT COLUMN: header (top) / title block (middle) / CTA (bottom) -->
    <div class="OurCollectionsMain-content">
      <span class="OurCollectionsMain-header">
        Откройте для себя наши коллекции
      </span>

      <div class="OurCollectionsMain-layers">
        <div class="content-layer layer-1 active">
          <div class="OurCollectionsMain-title-group">
            <div class="OurCollectionsMain-title-group__inner">
              <span class="OurCollectionsMain-index">
                {collections[0].index}
              </span>
              <h2 class="OurCollectionsMain-title">{collections[0].title}</h2>
              <p class="OurCollectionsMain-description">
                {collections[0].desc}
              </p>
            </div>
          </div>
        </div>
        <div class="content-layer layer-2">
          <div class="OurCollectionsMain-title-group">
            <div class="OurCollectionsMain-title-group__inner">
              <span class="OurCollectionsMain-index"></span>
              <h2 class="OurCollectionsMain-title"></h2>
              <p class="OurCollectionsMain-description"></p>
            </div>
          </div>
        </div>
      </div>

      <a href={collections[0].link} class="OurCollectionsMain-cta-pc">
        <span class="OurCollectionsMain-cta-pc__label">
          Посмотреть коллекцию
        </span>

        <div class="OurCollectionsMain-cta-pc__arrowWrapper">
          <svg
            class="OurCollectionsMain-cta-pc__arrow"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 45 10"
          >
            <path
              stroke="currentColor"
              stroke-width="1"
              d="M0 5h44m0 0-4-4m4 4-4 4"
            ></path>
          </svg>

          <svg
            class="OurCollectionsMain-cta-pc__arrowHover"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 45 10"
          >
            <path
              stroke="currentColor"
              stroke-width="1"
              d="M0 5h44m0 0-4-4m4 4-4 4"
            ></path>
          </svg>
        </div>
      </a>
    </div>

    <!-- RIGHT COLUMN: slider -->
    <div class="OurCollectionsMain-visual-wrapper">
      <div class="swiper OurCollectionsSwiper">
        <div class="swiper-wrapper">
          {collections.map((item) => (
            <div
              class="swiper-slide"
              data-index={item.index}
              data-title={item.title}
              data-desc={item.desc}
              data-link={item.link}
            >
              <img
                src={item.img}
                alt={item.title}
                class="OurCollectionsMain-img"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>

      <a href={collections[0].link} class="OurCollectionsMain-cta-mobile">
        <span class="OurCollectionsMain-cta-mobile__label">
          Посмотреть коллекцию
        </span>

        <div class="OurCollectionsMain-cta-mobile__arrowWrapper">
          <svg
            class="OurCollectionsMain-cta-mobile__arrow"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 45 10"
          >
            <path
              stroke="currentColor"
              stroke-width="1"
              d="M0 5h44m0 0-4-4m4 4-4 4"
            ></path>
          </svg>

          <svg
            class="OurCollectionsMain-cta-mobile__arrowHover"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 45 10"
          >
            <path
              stroke="currentColor"
              stroke-width="1"
              d="M0 5h44m0 0-4-4m4 4-4 4"
            ></path>
          </svg>
        </div>
      </a>

      <div class="OurCollectionsMain-controls">
        <div class="swiper-navigation-group">
          <button class="swiper-prev" aria-label="Previous slide">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 45 10"
            >
              <path stroke-width="1" d="M0 5h44m0 0-4-4m4 4-4 4"></path>
            </svg>
          </button>
          <button class="swiper-next" aria-label="Next slide">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 45 10"
            >
              <path stroke-width="1" d="M0 5h44m0 0-4-4m4 4-4 4"></path>
            </svg>
          </button>
        </div>

        <div class="swiper-progress-bar">
          <div class="swiper-progress-fill"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, EffectFade } from 'swiper/modules';
  // @ts-ignore
  import 'swiper/css/pagination';

  const swiper = new Swiper('.OurCollectionsSwiper', {
    modules: [Navigation, Pagination, EffectFade],
    loop: false,
    speed: 800,
    effect: 'fade',
    fadeEffect: { crossFade: true },
    navigation: {
      nextEl: '.swiper-next',
      prevEl: '.swiper-prev',
    },
  });

  const progressFill = document.querySelector(
    '.swiper-progress-fill'
  ) as HTMLElement;

  const ctaLinks = document.querySelectorAll<HTMLAnchorElement>(
    '.OurCollectionsMain-cta-pc, .OurCollectionsMain-cta-mobile'
  );

  const updateContent = () => {
    const totalSlides = swiper.slides.length;
    const currentIndex = swiper.activeIndex;
    const activeSlide = swiper.slides[currentIndex];

    if (progressFill) {
      const percentage = ((currentIndex + 1) / totalSlides) * 100;
      progressFill.style.width = `${percentage}%`;
    }

    if (activeSlide) {
      const newHref = activeSlide.getAttribute('data-link') || '#';
      ctaLinks.forEach((a) => (a.href = newHref));
    }

    const nextImgSrc = activeSlide
      ?.querySelector('.OurCollectionsMain-img')
      ?.getAttribute('src');
    const bgCurrent = document.getElementById(
      'bg-image-current'
    ) as HTMLImageElement;
    const bgNext = document.getElementById('bg-image-next') as HTMLImageElement;

    if (bgCurrent && bgNext && nextImgSrc && bgCurrent.src !== nextImgSrc) {
      bgNext.src = nextImgSrc;
      bgCurrent.style.opacity = '0';
      bgNext.style.opacity = '1';
      setTimeout(() => {
        bgCurrent.src = nextImgSrc;
        bgCurrent.style.opacity = '1';
        bgNext.style.opacity = '0';
      }, 250);
    }

    const layers = document.querySelectorAll('.content-layer');
    const outgoingLayer = document.querySelector(
      '.content-layer.active'
    ) as HTMLElement;
    const incomingLayer = Array.from(layers).find(
      (l) => l !== outgoingLayer
    ) as HTMLElement;

    if (incomingLayer && outgoingLayer && activeSlide) {
      const title = activeSlide.getAttribute('data-title') ?? '';
      const index = activeSlide.getAttribute('data-index') ?? '';
      const desc = activeSlide.getAttribute('data-desc') ?? '';

      incomingLayer.querySelector('.OurCollectionsMain-title')!.textContent =
        title;
      incomingLayer.querySelector('.OurCollectionsMain-index')!.textContent =
        index;
      incomingLayer.querySelector(
        '.OurCollectionsMain-description'
      )!.textContent = desc;

      outgoingLayer.classList.remove('active');
      incomingLayer.classList.add('active');
    }

    const prevBtn = document.querySelector('.swiper-prev') as HTMLButtonElement;
    const nextBtn = document.querySelector('.swiper-next') as HTMLButtonElement;
    if (prevBtn) prevBtn.disabled = swiper.isBeginning;
    if (nextBtn) nextBtn.disabled = swiper.isEnd;
  };

  swiper.on('slideChange', updateContent);

  updateContent();
</script>
